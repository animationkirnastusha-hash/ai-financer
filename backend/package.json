{
  "name": "backend",
  "version": "1.0.0",
  "description": "AI-Finance backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,json --exec tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "test": "node scripts/run-ai-tests.mjs",
    "test:ai": "node scripts/run-ai-tests.mjs",
    "test:ai:compiled": "node --test dist/modules/ai/__tests__/*.test.js",
    "test:product": "node scripts/run-product-tests.mjs",
    "test:product:report": "node scripts/run-product-tests.mjs --report-only",
    "reset:data": "node scripts/reset-app-data.mjs",
    "reset:sqlite": "node scripts/reset-sqlite-db.mjs",
    "db:sync": "prisma db push --accept-data-loss && prisma generate",
    "db:recover": "npm run db:sync",
    "test:token": "node scripts/create-test-token.mjs",
    "test:base-ai": "node scripts/run-basic-ai-regression.mjs",
    "test:base-ai:report": "node scripts/run-basic-ai-regression.mjs --report-only",
    "test:backend-integrity": "node scripts/run-backend-integrity-suite.mjs",
    "test:ai-confirm": "node scripts/run-backend-integrity-suite.mjs",
    "test:base-full": "npm run test:backend-integrity && npm run test:http-confirm && npm run test:base-ai",
    "test:http-confirm": "node scripts/run-http-confirm-smoke.mjs",
    "db:deploy": "prisma migrate deploy && prisma generate",
    "db:check-baseline": "node scripts/check-prisma-baseline.mjs",
    "db:status": "prisma migrate status",
    "smoke:predeploy": "node scripts/run-predeploy-smoke.mjs",
    "smoke:health": "node scripts/smoke/check-health-auth.mjs",
    "smoke:prisma": "node scripts/smoke/check-prisma-status.mjs",
    "smoke:ai": "node scripts/smoke/check-ai-base.mjs",
    "smoke:accounts": "node scripts/smoke/check-accounts-balances.mjs",
    "smoke:transactions": "node scripts/smoke/check-transactions.mjs",
    "smoke:taxonomy": "node scripts/smoke/check-taxonomy.mjs",
    "smoke:analytics": "node scripts/smoke/check-analytics.mjs",
    "smoke:reset-admin": "node scripts/smoke/check-reset-admin.mjs",
    "audit:final": "node scripts/run-final-audit.mjs",
    "notifications:deliver": "node -e \"fetch(process.env.TEST_BASE_URL || 'http://localhost:3000/api/notifications/deliver-telegram', {method:'POST', headers:{Authorization:'Bearer '+require('fs').readFileSync('.test-auth-token','utf8').trim()}}).then(r=>r.json()).then(x=>console.log(JSON.stringify(x,null,2))).catch(e=>{console.error(e);process.exit(1)})\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.15.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.73.5",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pdfkit": "^0.17.2",
    "prisma": "^5.22.0",
    "redis": "^5.8.2"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.3.0",
    "@types/pdfkit": "^0.17.3",
    "nodemon": "^3.1.10",
    "tsx": "^4.19.3",
    "typescript": "^5.9.2"
  }
}
