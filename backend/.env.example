NODE_ENV=production
PORT=3000
DATABASE_URL=file:./dev.db
JWT_SECRET=replace_with_32_plus_random_characters
AUTH_ACCESS_TOKEN_TTL=12h
AUTH_JWT_ISSUER=ai-financer-api
AUTH_JWT_AUDIENCE=ai-financer-web
TELEGRAM_BOT_TOKEN=replace_with_bot_token
TELEGRAM_WEB_APP_URL=https://your-telegram-mini-app-url.example
TELEGRAM_INIT_DATA_MAX_AGE_SEC=86400
FRONTEND_URL=https://your-frontend.example
CORS_ORIGINS=https://your-frontend.example,https://ai-financer.pages.dev

AI_PROVIDER=deepseek
AI_MODE=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FAST_MODEL=deepseek-chat
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONING_MODEL=deepseek-reasoner
AI_FAST_TIMEOUT_MS=8000
AI_LLM_TIMEOUT_MS=12000
AI_TIMEOUT_MS=10000
AI_DEBUG=false
ENABLE_CRON=true

# Voice STT: production voice layer uses OpenAI only.
# Financial meaning is not parsed here; this layer only converts audio to text.
OPENAI_API_KEY=your_openai_api_key_here
VOICE_STT_PROVIDER=openai
VOICE_STT_MODEL=gpt-4o-mini-transcribe
VOICE_LANGUAGE=ru
VOICE_MAX_AUDIO_MB=8
VOICE_PROVIDER_TIMEOUT_MS=45000
OPENAI_TRANSCRIBE_TIMEOUT_MS=45000
VOICE_AUDIO_NORMALIZE=1
VOICE_AUDIO_NORMALIZE_TIMEOUT_MS=12000
VOICE_DEBUG_LOGS=1

# Voice replies are intentionally disabled. Fina uses visual thoughts only.
VOICE_TTS_ENABLED=0
VOICE_TTS_PROVIDER=openai
VOICE_TTS_MODEL=gpt-4o-mini-tts
VOICE_TTS_VOICE=coral
VOICE_TTS_FORMAT=mp3
VOICE_TTS_CACHE=1
OPENAI_TTS_TIMEOUT_MS=30000

# Admin access is hidden from regular users. Use your Telegram numeric ID.
ADMIN_TELEGRAM_ID=516730814
ADMIN_TELEGRAM_IDS=516730814

# Internal monitoring / alerts.
ADMIN_ALERTS_ENABLED=false
ADMIN_ALERT_WEBHOOK_URL=
ADMIN_ALERT_COOLDOWN_MS=300000
API_SLOW_REQUEST_MS=2500
API_ERROR_RATE_THRESHOLD=0.2
