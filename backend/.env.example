NODE_ENV=production
PORT=3000
DATABASE_URL=file:./dev.db
JWT_SECRET=change_me
FRONTEND_URL=https://your-frontend.example
CORS_ORIGINS=https://your-frontend.example,https://ai-financer.pages.dev

AI_PROVIDER=deepseek
AI_MODE=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FAST_MODEL=deepseek-chat
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONING_MODEL=deepseek-reasoner
AI_FAST_TIMEOUT_MS=8000
AI_LLM_TIMEOUT_MS=12000
AI_TIMEOUT_MS=10000
AI_DEBUG=false
ENABLE_CRON=true
VOICE_STT_PROVIDER=openai
OPENAI_API_KEY=sk-...
VOICE_STT_MODEL=gpt-4o-mini-transcribe
VOICE_LANGUAGE=ru
VOICE_MAX_AUDIO_MB=8
VOICE_TTS_ENABLED=1
VOICE_TTS_PROVIDER=openai
VOICE_TTS_MODEL=gpt-4o-mini-tts
VOICE_TTS_VOICE=coral
VOICE_TTS_FORMAT=mp3
VOICE_TTS_CACHE=1
OPENAI_TTS_TIMEOUT_MS=30000
# Required for server-side voice transcription in Telegram/iOS WebView.
# DeepSeek does not provide speech-to-text, so voice uses OpenAI transcription.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Admin access is hidden from regular users. Use your Telegram numeric ID.
ADMIN_TELEGRAM_ID=516730814
# Optional comma-separated list for several admins.
ADMIN_TELEGRAM_IDS=516730814

# Internal monitoring / alerts.
ADMIN_ALERTS_ENABLED=false
ADMIN_ALERT_WEBHOOK_URL=
ADMIN_ALERT_COOLDOWN_MS=300000
API_SLOW_REQUEST_MS=2500
API_ERROR_RATE_THRESHOLD=0.2

# Normalize mobile audio with ffmpeg before STT. Keep enabled for iPhone/WebKit.
VOICE_AUDIO_NORMALIZE=1
VOICE_AUDIO_NORMALIZE_TIMEOUT_MS=12000
# Set to 1 only if you also want ffmpeg normalization for Gladia/Deepgram/AssemblyAI.
VOICE_AUDIO_NORMALIZE_ALL_PROVIDERS=0
