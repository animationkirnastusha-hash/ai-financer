NODE_ENV=production
PORT=3000
DATABASE_URL=file:./prod.db
JWT_SECRET=change_me

TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=

AI_PROVIDER=openrouter
AI_MODE=openrouter
AI_DEBUG=0

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FAST_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_REASONING_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_APP_TITLE=AI-financer

AI_TIMEOUT_MS=10000
AI_FAST_TIMEOUT_MS=8000
AI_LLM_TIMEOUT_MS=12000

FRONTEND_URL=https://your-frontend.pages.dev
ENABLE_CRON=true
